{
  "name": "@cindy/model-access-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Cindy model-access client/server model catalog wire contract. Zero runtime deps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm run build && vitest run && node --no-experimental-strip-types -e \"import('@cindy/model-access-protocol')\""
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
